# Copy to .env; never commit real keys. Base URL includes /v1, not /chat/completions.
APT_API_KEY=
APT_API_BASE_URL=https://api.openai.com/v1
# Set a Chat Completions model supported by your provider.
APT_MODEL=
APT_TARGET_LANGUAGE=Simplified Chinese
APT_TIMEOUT=90
APT_MAX_RETRIES=2
# Total character budget for neighboring context (not a tokenizer budget).
APT_CONTEXT_CHARS=6000
APT_MAX_CURRENT_CHARS=16000
# Local verified-translation cache. It may contain model output and paper text.
APT_CACHE_DIR=.apt-cache/translations
